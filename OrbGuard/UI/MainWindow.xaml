<!-- UI/MainWindow.xaml -->
<Window x:Class="OrbGuard.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrbGuard"
        WindowState="Maximized"
        ResizeMode="CanResize"
        Background="#1a1a2e">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <!-- ігрове поле -->
            <ColumnDefinition Width="200"/>
            <!-- панель HUD -->
        </Grid.ColumnDefinitions>

        <!-- Ігрове поле -->
        <Viewbox Grid.Column="0"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
            <Canvas x:Name="GameCanvas"
                    Width="1008"
                    Height="624"
                    ClipToBounds="True"
                    MouseLeftButtonDown="GameCanvas_MouseLeftButtonDown"
                    MouseRightButtonDown="GameCanvas_MouseRightButtonDown"/>
        </Viewbox>

        <!-- HUD панель -->
        <Border Grid.Column="1"
                Background="#16213e"
                BorderBrush="#0f3460"
                BorderThickness="2,0,0,0">
            <StackPanel Margin="12">

                <!-- Назва гри -->
                <TextBlock Text="OrbGuard"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#e94560"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,16"/>

                <Separator Background="#0f3460" Margin="0,0,0,12"/>

                <!-- Статистика -->
                <TextBlock Text="СТАТУС" Foreground="#888" FontSize="11" Margin="0,0,0,6"/>

                <DockPanel Margin="0,4">
                    <TextBlock Text="❤ HP Орба" Foreground="#aaa" FontSize="13"/>
                    <TextBlock x:Name="OrbHpText"
                               Text="100 / 100"
                               Foreground="#e94560"
                               FontSize="13"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               DockPanel.Dock="Right"/>
                </DockPanel>

                <!-- HP бар орба -->
                <Border Height="8" Background="#333" CornerRadius="4" Margin="0,2,0,8">
                    <Border x:Name="OrbHpBar"
                            Background="#e94560"
                            CornerRadius="4"
                            HorizontalAlignment="Left"
                            Width="176"/>
                </Border>

                <DockPanel Margin="0,4">
                    <TextBlock Text="💰 Золото" Foreground="#aaa" FontSize="13"/>
                    <TextBlock x:Name="GoldText"
                               Text="150"
                               Foreground="#f5a623"
                               FontSize="13"
                               FontWeight="Bold"
                               DockPanel.Dock="Right"/>
                </DockPanel>

                <DockPanel Margin="0,4,0,16">
                    <TextBlock Text="⚔️ Хвиля" Foreground="#aaa" FontSize="13"/>
                    <TextBlock x:Name="WaveText"
                               Text="0 / 10"
                               Foreground="#4ecdc4"
                               FontSize="13"
                               FontWeight="Bold"
                               DockPanel.Dock="Right"/>
                </DockPanel>

                <Separator Background="#0f3460" Margin="0,0,0,12"/>

                <!-- Вибір башти -->
                <TextBlock Text="БАШТИ" Foreground="#888" FontSize="11" Margin="0,0,0,8"/>

                <RadioButton x:Name="BasicTowerBtn"
                             Content="⬜ Basic — 100g"
                             Foreground="#4fc3f7"
                             FontSize="12"
                             IsChecked="True"
                             Margin="0,4"
                             GroupName="TowerSelect"/>

                <RadioButton x:Name="SniperTowerBtn"
                             Content="🔺 Sniper — 150g"
                             Foreground="#81c784"
                             FontSize="12"
                             Margin="0,4"
                             GroupName="TowerSelect"/>

                <RadioButton x:Name="SplashTowerBtn"
                             Content="⬡ Splash — 200g"
                             Foreground="#ff8a65"
                             FontSize="12"
                             Margin="0,4"
                             GroupName="TowerSelect"/>

                <TextBlock Text="ЛКМ — поставити башту"
                           Foreground="#555"
                           FontSize="10"
                           Margin="0,4,0,0"/>
                <TextBlock Text="ПКМ — прибрати башту"
                           Foreground="#555"
                           FontSize="10"
                           Margin="0,2,0,16"/>

                <Separator Background="#0f3460" Margin="0,0,0,12"/>

                <!-- Кнопки керування -->
                <Button x:Name="StartWaveBtn"
                        Content="▶ Почати хвилю"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="White"
                        Background="#0f3460"
                        BorderBrush="#4ecdc4"
                        BorderThickness="1"
                        Padding="8,10"
                        Margin="0,0,0,8"
                        Cursor="Hand"
                        Click="StartWaveBtn_Click"/>

                <CheckBox x:Name="AutoWaveCheckBox"
                          Content="Автозапуск хвиль"
                          Foreground="#aaa"
                          FontSize="12"
                          Margin="0,0,0,8"/>

                <Button x:Name="PauseBtn"
                        Content="⏸ Пауза"
                        FontSize="13"
                        Foreground="White"
                        Background="#0f3460"
                        BorderBrush="#888"
                        BorderThickness="1"
                        Padding="8,8"
                        Margin="0,0,0,8"
                        Cursor="Hand"
                        Click="PauseBtn_Click"/>

                <Button x:Name="ExitBtn"
                        Content="Вийти з гри"
                        FontSize="13"
                        Foreground="White"
                        Background="#6b1f2a"
                        BorderBrush="#e94560"
                        BorderThickness="1"
                        Padding="8,8"
                        Cursor="Hand"
                        Click="ExitBtn_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>